# Générique — préparé avant que le code réel n'existe (2026-07-16) ; à
# affiner une fois la stack choisie (ex. .venv/ ou node_modules/ selon Python
# ou Node).
node_modules/
__pycache__/
*.pyc
.venv/
.env
.DS_Store

# Artefact de mesure coverage (py -m coverage run --source=scripts ...) -
# regenere a chaque run, jamais du contenu source.
.coverage

# Claude Code — réglages/notes propres à une machine ou une personne (jamais
# partagés), à distinguer de .claude/settings.json et .claude/skills|hooks|
# agents/ qui eux restent versionnés pour toute l'équipe.
.claude/settings.local.json
CLAUDE.local.md

# BMAD — sorties générées (planning/implementation artifacts), pas du
# contenu source ; _bmad/ (le moteur) reste versionné à part.
_bmad-output/

# Superviseur d'agents (étage 1) — données locales de collecte, propres à la
# machine (offsets de scan, journal temps réel) ; les scripts restent versionnés.
.claude/supervision/state.json
.claude/supervision/usage.jsonl
.claude/supervision/diagnostic.json
.claude/orchestration/runs.jsonl
.claude/orchestration/routing-hints.json

# Générateur deck OHC — cache de photos fetchées (Openverse) pour les cadres
# des dividers de chapitre ; artefact reconstructible (scripts/
# generate_deck_ohc.py les retélécharge si absents), pas du contenu source.
# Même convention que VSCode3 (docs/cadrage-ppt/_img/).
scripts/_img/
